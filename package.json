{
  "name": "dsh-token-usage-dashboard",
  "version": "0.1.0",
  "description": "Persistent DeepSeek Harness token usage aggregation by provider and model",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./aggregate": "./lib/aggregate.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "author": "andron-ua",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andron-ua/dsh-token-usage-dashboard.git"
  },
  "bugs": {
    "url": "https://github.com/andron-ua/dsh-token-usage-dashboard/issues"
  },
  "homepage": "https://github.com/andron-ua/dsh-token-usage-dashboard#readme",
  "keywords": [
    "deepseek",
    "dsh",
    "token-usage",
    "dashboard",
    "cordis"
  ],
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-commands": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-session-query": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --check lib/index.js && node --check lib/client.js && node --check lib/aggregate.js && npm test",
    "prepack": "npm run check"
  }
}
